default_platform(:ios)

APP_ID = "com.studyen.app"

platform :ios do
  desc "签名打包并上传到 TestFlight（在 GitHub Actions 的 macOS runner 上运行）"
  lane :beta do
    # 注释掉 setup_ci，防止强制开启 match 只读
    # setup_ci

    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_P8_BASE64"],
      is_key_content_base64: true
    )

    create_keychain(
      name: "fastlane_tmp_keychain",
      password: "password",
      default_keychain: true,
      unlock: true,
      timeout: 3600
    )

    match(
      type: "appstore",
      app_identifier: APP_ID,
      team_id: ENV["TEAM_ID"],
      api_key: api_key,
      readonly: true,
      keychain_name: "fastlane_tmp_keychain",
      keychain_password: "password"
    )

    profile = lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING][APP_ID]

    build_app(
      project: "StudyEN.xcodeproj",
      scheme: "StudyEN",
      configuration: "Release",
      export_method: "app-store",
      export_options: { provisioningProfiles: { APP_ID => profile } },
      xcargs: [
        "CODE_SIGN_STYLE=Manual",
        "DEVELOPMENT_TEAM=#{ENV['TEAM_ID']}",
        "CODE_SIGN_IDENTITY='Apple Distribution'",
        "PROVISIONING_PROFILE_SPECIFIER='#{profile}'",
        "CURRENT_PROJECT_VERSION=#{ENV['BUILD_NUMBER']}"
      ].join(" ")
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
